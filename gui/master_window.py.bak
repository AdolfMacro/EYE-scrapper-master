    # ========================================================
    # REFRESH
    # ========================================================

    def refresh(self) -> None:

        try:

            self.controller.refresh()

            processes = self.controller.all_processes()

            if processes is None:
                processes = []

        except Exception as exc:

            self.connection_label.setText(
                "● MASTER ERROR"
            )

            self.connection_label.setStyleSheet(
                f"color: {RED};"
            )

            self._log(
                f"[REFRESH ERROR] {exc}"
            )

            return

        self.connection_label.setText(
            "● MASTER ONLINE"
        )

        self.connection_label.setStyleSheet(
            f"color: {GREEN};"
        )

        self._update_stats(processes)

        self._refresh_scraper_list(processes)

        if self.current_scraper:

            found = False

            for process in processes:

                if process.name == self.current_scraper:

                    found = True
                    break

            if found:

                self._load_scraper(
                    self.current_scraper
                )

            else:

                self.current_scraper = None

                self._clear_details()

    # ========================================================
    # STATS
    # ========================================================

    def _update_stats(
        self,
        processes,
    ) -> None:

        total = len(processes)

        running = 0
        starting = 0
        failed = 0
        finished = 0

        for process in processes:

            name = safe_get(
                process,
                "name",
            )

            if not name:
                continue

            try:

                status = self.controller.status(
                    name
                )

            except Exception:

                continue

            if status == ScraperStatus.RUNNING:
                running += 1

            elif status == ScraperStatus.STARTING:
                starting += 1

            elif status == ScraperStatus.CRASHED:
                failed += 1

            elif status == ScraperStatus.FINISHED:
                finished += 1

        self.total_value.setText(str(total))
        self.running_value.setText(str(running))
        self.starting_value.setText(str(starting))
        self.failed_value.setText(str(failed))
        self.finished_value.setText(str(finished))

    # ========================================================
    # LIST
    # ========================================================

    def _refresh_scraper_list(
        self,
        processes,
    ) -> None:

        selected = self.current_scraper

        self.scraper_list.blockSignals(True)

        self.scraper_list.clear()

        selected_item = None

        for process in processes:

            name = safe_get(
                process,
                "name",
            )

            if not name:
                continue

            try:

                status = self.controller.status(
                    name
                )

            except Exception:

                continue

            item = QListWidgetItem(
                f"{name}  //  {safe_status_value(status)}"
            )

            item.setData(
                Qt.UserRole,
                name,
            )

            item.setForeground(
                QColor(
                    safe_status_color(status)
                )
            )

            self.scraper_list.addItem(item)

            if name == selected:
                selected_item = item

        if selected_item is not None:

            self.scraper_list.setCurrentItem(
                selected_item
            )

        elif self.scraper_list.count():

            if not selected:

                self.scraper_list.setCurrentRow(0)

        self.scraper_list.blockSignals(False)

    # ========================================================
    # SELECT
    # ========================================================

    def _on_scraper_selected(
        self,
        current,
        previous,
    ) -> None:

        if current is None:

            self.current_scraper = None

            self._clear_details()

            return

        name = current.data(
            Qt.UserRole
        )

        if not name:

            self.current_scraper = None

            self._clear_details()

            return

        self.current_scraper = str(name)

        self._load_scraper(
            self.current_scraper
        )

    # ========================================================
    # LOAD
    # ========================================================

    def _load_scraper(
        self,
        name: str,
    ) -> None:

        try:

            snapshot = self.controller.snapshot(
                name
            )

        except Exception as exc:

            self._log(
                f"[SNAPSHOT ERROR] {name}: {exc}"
            )

            return

        try:

            record = self.controller.scraper_info(
                name
            )

        except Exception as exc:

            self._log(
                f"[INFO ERROR] {name}: {exc}"
            )

            return

        if record is None:

            self._clear_details()

            return

        status = safe_get(
            record,
            "status",
        )

        self.scraper_name.setText(
            str(
                safe_get(
                    record,
                    "name",
                    name,
                )
            )
        )

        status_text = safe_status_value(status)

        self.status_label.setText(
            status_text
        )

        color = safe_status_color(status)

        self.status_label.setStyleSheet(
            f"""
            color: {color};
            border: 1px solid {color};
            border-radius: 7px;
            padding: 6px 13px;
            font-size: 11px;
            font-weight: 900;
            """
        )

        pid = safe_get(
            record,
            "pid",
        )

        self.pid_value.setText(
            str(pid)
            if pid is not None
            else "-"
        )

        providers = safe_get(
            record,
            "providers",
            [],
        )

        if isinstance(
            providers,
            (list, tuple, set),
        ):

            provider_text = ", ".join(
                str(item)
                for item in providers
            )

        else:

            provider_text = str(
                providers or "-"
            )

        self.provider_value.setText(
            provider_text or "-"
        )

        self.target_value.setText(
            str(
                safe_get(
                    record,
                    "target",
                    None,
                )
                or "-"
            )
        )

        self.database_value.setText(
            str(
                safe_get(
                    record,
                    "database",
                    None,
                )
                or "-"
            )
        )

        self.started_value.setText(
            self._format_time(
                safe_get(
                    record,
                    "started_at",
                )
            )
        )

        exit_code = safe_get(
            record,
            "exit_code",
        )

        self.exit_value.setText(
            str(exit_code)
            if exit_code is not None
            else "-"
        )

        self._load_workflow(
            record
        )

        self._load_config(
            record
        )

        self._update_actions(
            name
        )

    # ========================================================
    # WORKFLOW
    # ========================================================

    def _load_workflow(
        self,
        record,
    ) -> None:

        config = safe_get(
            record,
            "config",
            {},
        )

        if not isinstance(
            config,
            dict,
        ):
            config = {}

        self.keyword_file_value.setText(
            str(
                config.get(
                    "keyword_file",
                    "-",
                )
            )
        )

        self.province_value.setText(
            str(
                config.get(
                    "province",
                    "-",
                )
            )
        )

        self.city_value.setText(
            str(
                config.get(
                    "city",
                    "-",
                )
            )
        )

        self.workflow_mode_value.setText(
            str(
                config.get(
                    "keyword_execution",
                    "-",
                )
            )
        )

    # ========================================================
    # CONFIG
    # ========================================================

    def _load_config(
        self,
        record,
    ) -> None:

        self.config_view.clear()

        config = safe_get(
            record,
            "config",
            {},
        )

        if not isinstance(
            config,
            dict,
        ):

            self.config_view.addItem(
                "{}"
            )

            return

        if not config:

            self.config_view.addItem(
                "{}"
            )

            return

        for key, value in config.items():

            if isinstance(
                value,
                dict,
            ):

                value = str(value)

            elif isinstance(
                value,
                (list, tuple, set),
            ):

                value = ", ".join(
                    str(item)
                    for item in value
                )

            self.config_view.addItem(
                f"{key}: {value}"
            )

    # ========================================================
    # NEW
    # ========================================================

    def _new_scraper(self) -> None:

        dialog = NewScraperDialog(self)

        if dialog.exec_() != QDialog.Accepted:
            return

        data = dialog.data()

        name = data["name"]

        try:

            if self.controller.exists(name):

                QMessageBox.warning(
                    self,
                    "SCRAPER EXISTS",
                    f"A scraper named '{name}' already exists.",
                )

                return

            self.controller.create_scraper(
                name=name,
                providers=data["providers"],
                target=data["target"],
                database=data["database"],
                config=data["config"],
                scraper_dir=data["scraper_dir"],
            )

            self.current_scraper = name

            self._log(
                f"[CREATE] {name}"
            )

            self._log(
                "[KEYWORDS] "
                f"{data['config'].get('keyword_file', '-')}"
            )

            self._log(
                "[LOCATION] "
                f"{data['config'].get('province', '-')} / "
                f"{data['config'].get('city', '-')}"
            )

            self._log(
                "[PROVIDER] "
                f"{data['providers']}"
            )

            self._log(
                "[MODE] SEQUENTIAL KEYWORD EXECUTION"
            )

            self.refresh()

            self._select_scraper(name)

        except Exception as exc:

            self._error(
                "CREATE SCRAPER FAILED",
                exc,
            )

    # ========================================================
    # SELECT BY NAME
    # ========================================================

    def _select_scraper(
        self,
        name: str,
    ) -> None:

        for index in range(
            self.scraper_list.count()
        ):

            item = self.scraper_list.item(index)

            if item.data(
                Qt.UserRole
            ) == name:

                self.scraper_list.setCurrentItem(
                    item
                )

                return

    # ========================================================
    # ACTIONS
    # ========================================================

    def _update_actions(
        self,
        name: str,
    ) -> None:

        try:

            actions = (
                self.controller.available_actions(
                    name
                )
            )

        except Exception as exc:

            self._log(
                f"[ACTION STATE ERROR] {exc}"
            )

            self._set_action_state(False)

            return

        if not isinstance(
            actions,
            dict,
        ):

            self._set_action_state(False)

            return

        self.start_button.setEnabled(
            bool(
                actions.get(
                    "start",
                    False,
                )
            )
        )

        self.stop_button.setEnabled(
            bool(
                actions.get(
                    "stop",
                    False,
                )
            )
        )

        self.restart_button.setEnabled(
            bool(
                actions.get(
                    "restart",
                    False,
                )
            )
        )

        self.kill_button.setEnabled(
            bool(
                actions.get(
                    "kill",
                    False,
                )
            )
        )

        self.remove_button.setEnabled(
            bool(
                actions.get(
                    "remove",
                    False,
                )
            )
        )

    def _set_action_state(
        self,
        enabled: bool,
    ) -> None:

        for button in (
            self.start_button,
            self.stop_button,
            self.restart_button,
            self.kill_button,
            self.remove_button,
        ):

            button.setEnabled(enabled)

    # ========================================================
    # START
    # ========================================================

    def _start_selected(self) -> None:

        self._run_action(
            "START",
            self.controller.start,
        )

    # ========================================================
    # STOP
    # ========================================================

    def _stop_selected(self) -> None:

        self._run_action(
            "STOP",
            self.controller.stop,
        )

    # ========================================================
    # RESTART
    # ========================================================

    def _restart_selected(self) -> None:

        self._run_action(
            "RESTART",
            self.controller.restart,
        )

    # ========================================================
    # GENERIC ACTION
    # ========================================================

    def _run_action(
        self,
        action_name: str,
        action,
    ) -> None:

        name = self.current_scraper

        if not name:
            return

        try:

            action(name)

            self._log(
                f"[{action_name}] {name}"
            )

            self.refresh()

        except Exception as exc:

            self._error(
                f"{action_name} FAILED",
                exc,
            )

    # ========================================================
    # KILL
    # ========================================================

    def _kill_selected(self) -> None:

        name = self.current_scraper

        if not name:
            return

        answer = QMessageBox.question(
            self,
            "KILL SCRAPER",
            f"Kill '{name}' immediately?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )

        if answer != QMessageBox.Yes:
            return

        try:

            self.controller.kill(name)

            self._log(
                f"[KILL] {name}"
            )

            self.refresh()

        except Exception as exc:

            self._error(
                "KILL FAILED",
                exc,
            )

    # ========================================================
    # REMOVE
    # ========================================================

    def _remove_selected(self) -> None:

        name = self.current_scraper

        if not name:
            return

        answer = QMessageBox.question(
            self,
            "REMOVE SCRAPER",
            f"Remove '{name}'?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )

        if answer != QMessageBox.Yes:
            return

        try:

            self.controller.remove(name)

            self._log(
                f"[REMOVE] {name}"
            )

            self.current_scraper = None

            self._clear_details()

            self.refresh()

        except Exception as exc:

            self._error(
                "REMOVE FAILED",
                exc,
            )

    # ========================================================
    # CLEAR
    # ========================================================

    def _clear_details(self) -> None:

        self.scraper_name.setText(
            "NO SCRAPER SELECTED"
        )

        self.status_label.setText("—")

        self.status_label.setStyleSheet("")

        for label in (
            self.pid_value,
            self.provider_value,
            self.target_value,
            self.database_value,
            self.started_value,
            self.exit_value,
            self.keyword_file_value,
            self.province_value,
            self.city_value,
            self.workflow_mode_value,
        ):

            label.setText("-")

        self.config_view.clear()

        self._set_action_state(False)

    # ========================================================
    # LOG
    # ========================================================

    def _log(
        self,
        message: str,
    ) -> None:

        if not hasattr(
            self,
            "log_view",
        ):
            return

        self.log_view.addItem(
            str(message)
        )

        self.log_view.scrollToBottom()

        # Prevent unlimited GUI memory growth.
        maximum = 1000

        while self.log_view.count() > maximum:

            self.log_view.takeItem(0)

    # ========================================================
    # ERROR
    # ========================================================

    def _error(
        self,
        title: str,
        exc: Exception,
    ) -> None:

        self._log(
            f"[ERROR] {title}: {exc}"
        )

        QMessageBox.critical(
            self,
            title,
            str(exc),
        )

    # ========================================================
    # TIME
    # ========================================================

    @staticmethod
    def _format_time(
        value: Any,
    ) -> str:

        if value is None:
            return "-"

        try:

            import datetime

            if isinstance(
                value,
                datetime.datetime,
            ):

                return value.strftime(
                    "%Y-%m-%d %H:%M:%S"
                )

            if isinstance(
                value,
                (int, float),
            ):

                return (
                    datetime.datetime
                    .fromtimestamp(value)
                    .strftime(
                        "%Y-%m-%d %H:%M:%S"
                    )
                )

        except Exception:
            pass

        return str(value)

    # ========================================================
    # CLOSE
    # ========================================================

    def closeEvent(
        self,
        event,
    ) -> None:

        try:
            self.refresh_timer.stop()
        except Exception:
            pass

        event.accept()