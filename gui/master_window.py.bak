    # ========================================================
    # INTEGER
    # ========================================================

    @staticmethod
    def _integer(
        minimum: int,
        maximum: int,
        default: int,
    ) -> QSpinBox:

        widget = QSpinBox()

        widget.setRange(
            minimum,
            maximum,
        )

        widget.setValue(
            default
        )

        widget.setButtonSymbols(
            QSpinBox.PlusMinus
        )

        return widget

    # ========================================================
    # KEYWORD FILE
    # ========================================================

    def _browse_keyword_file(self) -> None:

        directory = str(
            Path(
                self.keyword_file_edit.text().strip()
                or DEFAULT_KEYWORD_FILE
            ).parent
        )

        path, _ = QFileDialog.getOpenFileName(
            self,
            "SELECT KEYWORD FILE",
            directory,
            "Text Files (*.txt);;All Files (*)",
        )

        if not path:
            return

        self.keyword_file_edit.setText(path)

        self._load_keyword_preview()

    # ========================================================
    # KEYWORD PREVIEW
    # ========================================================

    def _read_keywords(self) -> list[str]:

        path = Path(
            self.keyword_file_edit.text().strip()
        )

        if not path.is_file():
            return []

        keywords = []

        try:

            with path.open(
                "r",
                encoding="utf-8",
            ) as file:

                for raw_line in file:

                    line = raw_line.strip()

                    if not line:
                        continue

                    if line.startswith("#"):
                        continue

                    keywords.append(line)

        except OSError:
            return []

        return keywords

    def _load_keyword_preview(self) -> None:

        self.keyword_preview.clear()

        path = Path(
            self.keyword_file_edit.text().strip()
        )

        if not path.is_file():

            self.keyword_info.setText(
                "⚠ KEYWORD FILE NOT FOUND"
            )

            self.keyword_info.setStyleSheet(
                f"color: {RED};"
            )

            return

        keywords = self._read_keywords()

        self.keyword_info.setStyleSheet(
            f"color: {GREEN};"
        )

        self.keyword_info.setText(
            f"● {len(keywords)} KEYWORDS LOADED"
        )

        limit = 100

        for index, keyword in enumerate(
            keywords[:limit],
            start=1,
        ):

            item = QListWidgetItem(
                f"{index:03d}  //  {keyword}"
            )

            item.setData(
                Qt.UserRole,
                keyword,
            )

            self.keyword_preview.addItem(item)

        if len(keywords) > limit:

            self.keyword_preview.addItem(
                f"... {len(keywords) - limit} MORE KEYWORDS"
            )

    # ========================================================
    # DATABASE
    # ========================================================

    def _update_database_path(
        self,
        name: str,
    ) -> None:

        name = name.strip()

        if not name:
            return

        current = self.database_edit.text().strip()

        if (
            current
            and not current.startswith(
                "runtime/databases/"
            )
        ):
            return

        self.database_edit.setText(
            str(
                Path("runtime")
                / "databases"
                / f"{name}.db"
            )
        )

    # ========================================================
    # PROVIDERS
    # ========================================================

    def _populate_providers(self) -> None:

        providers: list[str] = []

        try:

            from providers.manager import ProviderManager

            manager = ProviderManager()

            candidates = []

            # ----------------------------------------------
            # list_providers()
            # ----------------------------------------------

            method = getattr(
                manager,
                "list_providers",
                None,
            )

            if callable(method):

                result = method()

                if result:
                    candidates = result

            # ----------------------------------------------
            # available_providers()
            # ----------------------------------------------

            if not candidates:

                method = getattr(
                    manager,
                    "available_providers",
                    None,
                )

                if callable(method):

                    result = method()

                    if result:
                        candidates = result

            # ----------------------------------------------
            # providers
            # ----------------------------------------------

            if not candidates:

                value = getattr(
                    manager,
                    "providers",
                    None,
                )

                if callable(value):

                    value = value()

                if value:
                    candidates = value

            # ----------------------------------------------
            # registry
            # ----------------------------------------------

            if not candidates:

                registry = getattr(
                    manager,
                    "registry",
                    None,
                )

                if isinstance(
                    registry,
                    dict,
                ):

                    candidates = registry.keys()

                else:

                    method = getattr(
                        registry,
                        "list",
                        None,
                    )

                    if callable(method):

                        result = method()

                        if result:
                            candidates = result

            for provider in candidates or []:

                name = normalize_provider_name(
                    provider
                )

                if name:
                    providers.append(name)

        except Exception:
            providers = []

        if not providers:

            providers = list(
                DEFAULT_PROVIDERS
            )

        providers = sorted(
            set(providers),
            key=str.lower,
        )

        self.providers_list.clear()

        for provider in providers:

            item = QListWidgetItem(
                f"◉  {provider}"
            )

            item.setData(
                Qt.UserRole,
                provider,
            )

            self.providers_list.addItem(item)

        if self.providers_list.count():

            self.providers_list.setCurrentRow(0)

    # ========================================================
    # VALIDATE
    # ========================================================

    def _validate(self) -> None:

        name = self.name_edit.text().strip()

        if not name:

            QMessageBox.warning(
                self,
                "INVALID SCRAPER",
                "Scraper name cannot be empty.",
            )

            self.name_edit.setFocus()

            return

        keyword_file = (
            self.keyword_file_edit
            .text()
            .strip()
        )

        keyword_path = Path(keyword_file)

        if not keyword_file:

            QMessageBox.warning(
                self,
                "INVALID KEYWORD FILE",
                "Select a keyword file.",
            )

            return

        if not keyword_path.is_file():

            QMessageBox.warning(
                self,
                "KEYWORD FILE NOT FOUND",
                "The selected keyword file does not exist.",
            )

            return

        if not self._read_keywords():

            QMessageBox.warning(
                self,
                "EMPTY KEYWORD FILE",
                "The selected keyword file contains no keywords.",
            )

            return

        province = self.province_edit.text().strip()

        city = self.city_edit.text().strip()

        if not province:

            QMessageBox.warning(
                self,
                "INVALID LOCATION",
                "Province cannot be empty.",
            )

            self.province_edit.setFocus()

            return

        if not city:

            QMessageBox.warning(
                self,
                "INVALID LOCATION",
                "City cannot be empty.",
            )

            self.city_edit.setFocus()

            return

        item = self.providers_list.currentItem()

        if item is None:

            QMessageBox.warning(
                self,
                "INVALID PROVIDER",
                "Select a search provider.",
            )

            self.providers_list.setFocus()

            return

        database = (
            self.database_edit
            .text()
            .strip()
        )

        if not database:

            QMessageBox.warning(
                self,
                "INVALID DATABASE",
                "Database path cannot be empty.",
            )

            self.database_edit.setFocus()

            return

        self.accept()

    # ========================================================
    # DATA
    # ========================================================

    def data(self) -> dict:

        item = self.providers_list.currentItem()

        provider = ""

        if item is not None:

            provider = str(
                item.data(Qt.UserRole)
                or ""
            ).strip()

        providers = (
            [provider]
            if provider
            else []
        )

        province = (
            self.province_edit
            .text()
            .strip()
        )

        city = (
            self.city_edit
            .text()
            .strip()
        )

        config = {

            # ----------------------------------------------
            # KEYWORDS
            # ----------------------------------------------

            "keyword_file": (
                self.keyword_file_edit
                .text()
                .strip()
            ),

            "keyword_mode": "file",

            "keyword_execution": "sequential",

            "process_all_keywords": True,

            "stop_on_keyword_error": False,

            # ----------------------------------------------
            # LOCATION
            # ----------------------------------------------

            "province": province,

            "city": city,

            "location": {
                "province": province,
                "city": city,
            },

            # ----------------------------------------------
            # SEARCH
            # ----------------------------------------------

            "max_queries": (
                self.max_queries_spin.value()
            ),

            "pages_per_query": (
                self.pages_per_query_spin.value()
            ),

            "results_per_page": (
                self.results_per_page_spin.value()
            ),

            "delay": (
                self.delay_spin.value()
            ),

            "timeout": (
                self.timeout_spin.value()
            ),

            "search_provider": providers,
        }

        # ----------------------------------------------
        # ADVANCED
        # ----------------------------------------------

        for raw_line in (
            self.config_edit
            .toPlainText()
            .splitlines()
        ):

            line = raw_line.strip()

            if not line:
                continue

            if line.startswith("#"):
                continue

            if "=" not in line:
                continue

            key, value = line.split(
                "=",
                1,
            )

            key = key.strip()
            value = value.strip()

            if key:
                config[key] = value

        return {
            "name": (
                self.name_edit
                .text()
                .strip()
            ),

            "providers": providers,

            "target": (
                self.target_edit
                .text()
                .strip()
                or None
            ),

            "database": (
                self.database_edit
                .text()
                .strip()
                or None
            ),

            "scraper_dir": (
                self.scraper_dir_edit
                .text()
                .strip()
                or None
            ),

            "config": config,
        }

    # ========================================================
    # STYLE
    # ========================================================

    def _apply_style(self) -> None:

        self.setStyleSheet(
            f"""
            QDialog {{
