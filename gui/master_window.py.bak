# ============================================================
# STATUS COLORS
# ============================================================

STATUS_COLORS = {
    ScraperStatus.CREATED: TEXT_MUTED,
    ScraperStatus.STARTING: AMBER,
    ScraperStatus.RUNNING: GREEN,
    ScraperStatus.STOPPING: AMBER,
    ScraperStatus.STOPPED: TEXT_MUTED,
    ScraperStatus.FINISHED: BLUE,
    ScraperStatus.CRASHED: RED,
    ScraperStatus.KILLED: RED,
}


# ============================================================
# SAFE HELPERS
# ============================================================

def safe_status_color(status: Any) -> str:
    return STATUS_COLORS.get(
        status,
        TEXT_SECONDARY,
    )


def safe_status_value(status: Any) -> str:
    if status is None:
        return "-"

    value = getattr(
        status,
        "value",
        status,
    )

    return str(value)


def safe_get(
    obj: Any,
    name: str,
    default: Any = None,
) -> Any:
    if obj is None:
        return default

    if isinstance(obj, dict):
        return obj.get(
            name,
            default,
        )

    return getattr(
        obj,
        name,
        default,
    )


def normalize_provider_name(
    provider: Any,
) -> str:

    if provider is None:
        return ""

    if isinstance(provider, str):
        return provider.strip()

    if isinstance(provider, dict):
        value = (
            provider.get("name")
            or provider.get("id")
            or provider.get("key")
        )

        return str(
            value or ""
        ).strip()

    value = getattr(
        provider,
        "name",
        None,
    )

    if value:
        return str(
            value
        ).strip()

    return str(
        provider
    ).strip()


