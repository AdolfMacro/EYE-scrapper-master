    # ========================================================
    # STAT
    # ========================================================

    @staticmethod
    def _create_stat(
        parent_layout: QHBoxLayout,
        title: str,
        color: str,
    ) -> QLabel:

        card = QFrame()

        card.setObjectName(
            "StatCard"
        )

        layout = QVBoxLayout(card)

        layout.setContentsMargins(
            14,
            10,
            14,
            10,
        )

        layout.setSpacing(2)

        title_label = QLabel(title)

        title_label.setObjectName(
            "StatTitle"
        )

        value = QLabel("0")

        value.setObjectName(
            "StatValue"
        )

        value.setStyleSheet(
            f"color: {color};"
        )

        layout.addWidget(title_label)
        layout.addWidget(value)

        parent_layout.addWidget(card)

        return value

    # ========================================================
    # RUNTIME ROW
    # ========================================================

    @staticmethod
    def _runtime_row(
        layout: QVBoxLayout,
        name: str,
        value: QLabel,
    ) -> None:

        row = QHBoxLayout()

        key = QLabel(name)

        key.setObjectName(
            "RuntimeKey"
        )

        value.setObjectName(
            "RuntimeValue"
        )

        value.setTextInteractionFlags(
            Qt.TextSelectableByMouse
        )

        row.addWidget(key)
        row.addStretch()
        row.addWidget(value)

        layout.addLayout(row)

